#include <iostream>
#include <cmath>
using namespace std;
int main() {
    int n, maxIterations;
    double tolerance;
    cout << "Enter number of variables: ";
    cin >> n;
    double a[n][n], b[n], x[n];
    cout << "Enter coefficient matrix A:\n";
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            cin >> a[i][j];
    cout << "Enter constant vector B:\n";
    for (int i = 0; i < n; i++)
        cin >> b[i];
    cout << "Enter initial guess:\n";
    for (int i = 0; i < n; i++)
        cin >> x[i];
    cout << "Enter tolerance: ";
    cin >> tolerance;
    cout << "Enter maximum iterations: ";
    cin >> maxIterations;
    cout << "\nIter\t";
    for (int i = 0; i < n; i++)
        cout << "x" << i+1 << "\t";
    cout << endl;
    for (int k = 1; k <= maxIterations; k++) {
        cout << k << "\t";
        for (int i = 0; i < n; i++) {
            double sum = b[i];
            for (int j = 0; j < n; j++) {
                if (j != i)
                    sum -= a[i][j] * x[j];
            }
            x[i] = sum / a[i][i];
            cout << x[i] << "\t";
        }
        cout << endl;
        bool converged = true;
        for (int i = 0; i < n; i++) {
            double sum = b[i];
            for (int j = 0; j < n; j++) {
                if (j != i)
                    sum -= a[i][j] * x[j];
            }
            if (fabs(x[i] - sum / a[i][i]) > tolerance) {
                converged = false;
                break;
            }
        }
        if (converged) {
            cout << "\nSolution converged.\n";
            break;
        }
    }
    cout << "\nFinal Solution:\n";
    for (int i = 0; i < n; i++)
        cout << "x" << i+1 << " = " << x[i] << endl;
    return 0;
}
