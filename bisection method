#include <iostream>
#include <cmath>
using namespace std;
double f(double x) {
    return x*x*x - x - 2;  // Example: x^3 - x - 2 = 0
}
int main() {
    double a, b, c;
    int maxIterations;
    double tolerance;
    cout << "Enter initial guesses a and b: ";
    cin >> a >> b;
    cout << "Enter tolerance: ";
    cin >> tolerance;
    cout << "Enter maximum iterations: ";
    cin >> maxIterations;
    if (f(a) * f(b) >= 0) {
        cout << "Invalid interval. f(a) and f(b) must have opposite signs.\n";
        return 1;
    }
    cout << "\nIter\t a\t b\t c\t f(c)\n";
    for (int i = 1; i <= maxIterations; i++) {
        c = (a + b) / 2;
        cout << i << "\t" << a << "\t" << b << "\t" << c << "\t" << f(c) << endl;
        if (fabs(f(c)) < tolerance) {
            cout << "\nRoot found: " << c << endl;
            return 0;
        }
        if (f(a) * f(c) < 0)
            b = c;
        else
            a = c;
    }
    cout << "\nApproximate root after " << maxIterations << " iterations: " << c << endl;
    return 0;
}
