#include <iostream>
#include <cmath>
using namespace std;
double f(double x) {
    return x*x*x - x - 2;   
}
double df(double x) {
    return 3*x*x - 1;      
}
int main() {
    double x0, x1;
    double tolerance;
    int maxIterations;
    cout << "Enter initial guess: ";
    cin >> x0;
    cout << "Enter tolerance: ";
    cin >> tolerance;
    cout << "Enter maximum iterations: ";
    cin >> maxIterations;
    cout << "\nIter\t x0\t x1\t f(x1)\n";
    for (int i = 1; i <= maxIterations; i++) {
        if (df(x0) == 0) {
            cout << "Derivative is zero. Method fails.\n";
            return 1;
        }
        x1 = x0 - f(x0) / df(x0);
        cout << i << "\t" << x0 << "\t" << x1 << "\t" << f(x1) << endl;
        if (fabs(x1 - x0) < tolerance) {
            cout << "\nRoot found: " << x1 << endl;
            return 0;
        }
        x0 = x1;
    }
    cout << "\nApproximate root after " << maxIterations << " iterations: " << x1 << endl;
    return 0;
}
